{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/Los_Angeles",
  "labels": ["dependencies", "automated"],
  "schedule": ["before 4am on Friday"],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 4am on Friday"]
  },
  "packageRules": [
    {
      "description": "Group all nix flake input lock updates into one PR (matching existing workflow behavior)",
      "matchManagers": ["nix"],
      "matchUpdateTypes": ["digest", "patch", "minor", "major"],
      "groupName": "Nix flake inputs",
      "labels": ["dependencies", "automated"]
    }
  ],
  "enabledManagers": ["nix"],
  "prHourlyLimit": 4,
  "prConcurrentLimit": 10
}
